#!/bin/sh
set -eu

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf '%s\n' "Missing $1. Enter the project Nix shell or install $1 before continuing." >&2
    exit 1
  fi
}

require_command opencode
opencode --version
opencode mcp list
opencode mcp auth list

require_command flutter
require_command deno
require_command supabase
require_command docker

flutter --version
deno --version
supabase --version
docker version
