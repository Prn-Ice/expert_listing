use flake

# Flutter must use the standard host Xcode, not Nix's macOS SDK stub.
if [[ "$OSTYPE" == darwin* ]]; then
  unset DEVELOPER_DIR
  unset SDKROOT
  # Xcode invokes the compiler driver for iOS package linking; Nix's raw ld
  # rejects those driver flags.
  unset LD
  # The flake's xcbuild package shadows /usr/bin/xcrun with a stub that cannot
  # locate host SDKs (iOS included); the real Xcode tools must win.
  export PATH="/usr/bin:$PATH"
fi

dotenv_if_exists .env.local
