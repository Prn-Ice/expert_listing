# Public Flutter build configuration.
API_BASE_URL=

# Server-only Supabase configuration. Do not bundle these values into Flutter.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EXPECTED_SUPABASE_PROJECT_REF=

# Non-secret local-only opt-in. Hosted Supabase URLs ignore this setting.
ALLOW_PREVIEW_ACTORS=false
